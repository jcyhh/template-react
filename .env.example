# Runtime endpoints and shared project values.
# 运行时接口地址和项目通用值。

# API request base URL; empty value means using the current site origin.
# 接口请求基础地址；为空时表示使用当前站点域名。
VITE_BASE_URL =

# Blockchain RPC endpoint used by wallet and contract calls.
# 钱包和合约调用使用的区块链 RPC 节点地址。
VITE_RPC_URL =

# DApp target chain config.
# DApp 目标链配置。

# Target chain id used for production chain switching; blank defaults to BNB Smart Chain 56.
# 生产环境强制切换的钱包链 ID；为空时默认使用 BNB Smart Chain 的 56。
VITE_CHAIN_ID =

# Target chain display name shown when adding the chain to the wallet.
# 添加链到钱包时展示的目标链名称。
VITE_CHAIN_NAME =

# Native token name of the target chain.
# 目标链原生代币名称。
VITE_CHAIN_NATIVE_NAME =

# Native token symbol of the target chain.
# 目标链原生代币符号。
VITE_CHAIN_NATIVE_SYMBOL =

# Native token decimals of the target chain; blank defaults to 18.
# 目标链原生代币精度；为空时默认 18。
VITE_CHAIN_NATIVE_DECIMALS =

# Block explorer URL shown by the wallet after adding the chain.
# 添加链后钱包展示的区块浏览器地址。
VITE_CHAIN_EXPLORER_URL =

# Minimum native token balance required before contract writes; blank defaults to 0.0004.
# 写合约前要求的最低原生代币 Gas 余额；为空时默认 0.0004。
VITE_MIN_GAS_BALANCE =

# Whether contract writes should check gas balance first; 1 = enabled, 0 = disabled.
# 写合约前是否检查 Gas 余额；1 表示开启，0 表示关闭。
VITE_ENABLE_DAPP_GAS_CHECK = 1

# Whether production contract writes should estimate and submit gas; 1 = enabled, 0 = disabled.
# 生产环境写合约时是否由前端估算并提交 gas；1 表示开启，0 表示关闭。
VITE_ENABLE_DAPP_GAS_ESTIMATE = 1

# Whether insufficient ERC20 allowance should be approved with the max amount; 1 = max amount, 0 = requested amount.
# ERC20 授权额度不足时是否授权最大额度；1 表示最大额度，0 表示只授权本次需要额度。
VITE_ENABLE_ERC20_MAX_APPROVE = 1

# Decimals used when converting DApp display amounts and on-chain integer units; blank defaults to 18.
# DApp 展示金额和链上整数单位互转时使用的小数位；为空时默认 18。
VITE_DAPP_AMOUNT_DECIMALS =

# USDT contract address or asset identifier used by the current chain.
# 当前链上使用的 USDT 合约地址或资产标识。
VITE_USDT =

# App display information.
# 应用展示信息。

# Browser title and mobile web app title.
# 浏览器标题和移动端 Web App 标题。
VITE_APP_NAME =

# Social sharing metadata for link previews.
# 链接预览使用的社交分享元信息。

# Whether to inject social sharing meta tags into index.html.
# 是否向 index.html 注入社交分享 meta 标签。
VITE_ENABLE_SOCIAL_META = 0

# Page title shown in Telegram, X, Discord, Facebook and similar platforms.
# Telegram、X、Discord、Facebook 等平台展示的页面标题。
VITE_SOCIAL_TITLE =

# Page description shown in social link previews and the HTML description meta.
# 社交链接预览和 HTML description meta 展示的页面描述。
VITE_SOCIAL_DESCRIPTION =

# Canonical page URL used by social platforms; use a public absolute URL.
# 社交平台识别的页面标准地址；使用公网可访问的绝对地址。
VITE_SOCIAL_URL =

# Share preview image URL; use a public absolute URL, recommended size 1200x630.
# 分享预览图片地址；使用公网可访问的绝对地址，推荐尺寸 1200x630。
VITE_SOCIAL_IMAGE =

# Share preview image width in pixels.
# 分享预览图片宽度，单位为 px。
VITE_SOCIAL_IMAGE_WIDTH =

# Share preview image height in pixels.
# 分享预览图片高度，单位为 px。
VITE_SOCIAL_IMAGE_HEIGHT =

# Alternative text for the share preview image.
# 分享预览图片的替代文本。
VITE_SOCIAL_IMAGE_ALT =

# Open Graph locale code, for example en_US or zh_CN.
# Open Graph 使用的语言地区代码，例如 en_US 或 zh_CN。
VITE_SOCIAL_LOCALE =

# X/Twitter account that owns the site, for example @project_name.
# X/Twitter 站点所属账号，例如 @project_name。
VITE_SOCIAL_X_SITE =

# X/Twitter account that created the content, for example @project_name.
# X/Twitter 内容作者账号，例如 @project_name。
VITE_SOCIAL_X_CREATOR =
